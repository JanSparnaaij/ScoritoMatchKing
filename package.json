  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "magicast": "0.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
